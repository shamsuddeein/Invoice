# ── Turso (production libSQL) ────────────────────────────────────────
# Dev can instead use a local file:  TURSO_DATABASE_URL=file:local.db
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# ── NextAuth v5 ──────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=generate-a-32-char-random-string-here
NEXTAUTH_SECRET=generate-a-32-char-random-string-here
NEXTAUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# ── Single owner login ───────────────────────────────────────────────
OWNER_USERNAME=admin
OWNER_PASSWORD=use-a-strong-password-here
